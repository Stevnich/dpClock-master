<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       macOS look for Avalonia (Dark Aqua). Load AFTER FluentTheme.
       Colours/fonts come from MacResources.axaml.

       Opt-in classes:
         Button.primary   blue default button
         Button.large     large push button (clock buttons)
         NumericUpDown.time   big clock-style field
         TextBlock.display / displaySmall / heading / columnHeader
       ============================================================ -->

  <!-- ================= Window / text ================= -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource MacWindowBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource MacLabel}"/>
    <Setter Property="FontFamily" Value="{DynamicResource MacFont}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{DynamicResource MacMonoFont}"/>
    <Setter Property="FontSize" Value="40"/>
    <Setter Property="FontWeight" Value="Light"/>
  </Style>
  <Style Selector="TextBlock.displaySmall">
    <Setter Property="FontFamily" Value="{DynamicResource MacMonoFont}"/>
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="Light"/>
    <Setter Property="Foreground" Value="{DynamicResource MacSecondaryLabel}"/>
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontFamily" Value="{DynamicResource MacMonoFont}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.columnHeader">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource MacSecondaryLabel}"/>
  </Style>

  <!-- ================= Push buttons ================= -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource MacButtonBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource MacLabel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MacButtonBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="14,3"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MacButtonBackgroundHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MacButtonBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource MacLabel}"/>
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MacButtonBackgroundPressed}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MacButtonBorder}"/>
    <Setter Property="Foreground" Value="{DynamicResource MacLabel}"/>
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MacButtonBackgroundDisabled}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource MacTertiaryLabel}"/>
  </Style>

  <Style Selector="Button.large">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="MinHeight" Value="44"/>
  </Style>

  <!-- Default (blue) button -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource MacAccent}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MacAccentHover}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MacAccentPressed}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MacButtonBackgroundDisabled}"/>
    <Setter Property="Foreground" Value="{DynamicResource MacTertiaryLabel}"/>
  </Style>

  <!-- ================= Traffic lights (non-macOS only) ================= -->
  <Style Selector="Button.traffic">
    <Setter Property="Width" Value="12"/>
    <Setter Property="Height" Value="12"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Width="12" Height="12" CornerRadius="6"
                Background="{TemplateBinding Background}"
                BorderBrush="#33000000" BorderThickness="0.5">
          <TextBlock Name="glyph" Text="{TemplateBinding Content}"
                     FontSize="9" FontWeight="Heavy" Foreground="#99000000"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.traffic.close"><Setter Property="Background" Value="#FF5F57"/></Style>
  <Style Selector="Button.traffic.minimize"><Setter Property="Background" Value="#FEBC2E"/></Style>
  <Style Selector="Button.traffic.zoom"><Setter Property="Background" Value="#28C840"/></Style>
  <Style Selector="Button.traffic:disabled"><Setter Property="Background" Value="#4D4D50"/></Style>
  <Style Selector="Button.traffic:pressed"><Setter Property="Opacity" Value="0.7"/></Style>
  <!-- glyphs appear when the pointer is anywhere over the group -->
  <Style Selector="Border.lights:pointerover Button.traffic:not(:disabled) /template/ TextBlock#glyph">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- ================= Segmented control (TabControl) ================= -->
  <Style Selector="TabControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2"/>
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <Border DockPanel.Dock="Top" HorizontalAlignment="Center"
                  Margin="0,10,0,10" Padding="2" CornerRadius="8"
                  Background="{DynamicResource MacSegmentTrack}">
            <ItemsPresenter Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
          </Border>
          <ContentPresenter Name="PART_SelectedContentHost"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="TabItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource MacLabel}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="16,2"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Cursor" Value="Arrow"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <!-- named "Presenter" on purpose, so FluentTheme's TabItem rules do not apply to it -->
          <ContentPresenter Name="Presenter"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource MacSegmentHover}"/>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Background" Value="{DynamicResource MacSegmentSelected}"/>
  </Style>
  <Style Selector="TabItem:selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource MacSegmentSelected}"/>
  </Style>

  <!-- ================= Text fields ================= -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource MacAccent}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource MacAccent}"/>
  </Style>
  <!-- macOS focus ring -->
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource MacAccent}"/>
    <Setter Property="BoxShadow" Value="0 0 0 3 #660A84FF"/>
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource MacInputBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource MacLabel}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MacInputBorder}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="MinHeight" Value="28"/>
  </Style>
  <Style Selector="NumericUpDown.time">
    <Setter Property="FontFamily" Value="{DynamicResource MacMonoFont}"/>
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="FontWeight" Value="Light"/>
    <Setter Property="MinHeight" Value="48"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <!-- ================= Lists ================= -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource MacLabel}"/>
    <Setter Property="FontFamily" Value="{DynamicResource MacMonoFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MacRowHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource MacLabel}"/>
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MacAccent}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MacAccent}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MacAccentPressed}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>

  <!-- ================= Menus ================= -->
  <Style Selector="Menu">
    <Setter Property="Background" Value="{DynamicResource MacToolbarBackground}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Padding" Value="5"/>
    <Setter Property="MinWidth" Value="188"/>
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="CornerRadius" Value="5"/>
  </Style>

  <!-- ================= Separator ================= -->
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource MacSeparator}"/>
    <Setter Property="Height" Value="1"/>
  </Style>
</Styles>
